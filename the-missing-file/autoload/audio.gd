extends Node
## Music, ambience and sound effects. All sounds are original, generated by
## tools/make_audio.py.

const DIR := "res://assets/audio/"
const SFX := ["click", "paper", "found", "insight", "wrong", "stamp", "step"]

var _sfx := {}
var _players: Array = []
var _next := 0
var _music: AudioStreamPlayer
var _ambience: AudioStreamPlayer
var _ambience_name := ""


func _ready() -> void:
	for bus_name in ["Music", "Sfx"]:
		AudioServer.add_bus()
		AudioServer.set_bus_name(AudioServer.bus_count - 1, bus_name)
	for name in SFX:
		_sfx[name] = load(DIR + name + ".wav")
	for i in 6:
		var p := AudioStreamPlayer.new()
		p.bus = "Sfx"
		add_child(p)
		_players.append(p)
	_music = _looping_player("music", "Music", -8.0)
	_ambience = AudioStreamPlayer.new()
	_ambience.bus = "Sfx"
	_ambience.volume_db = -10.0
	add_child(_ambience)
	Settings.volume_changed.connect(_apply_volumes)
	_apply_volumes()
	_music.play()


func _loop_stream(name: String) -> AudioStreamWAV:
	var stream: AudioStreamWAV = load(DIR + name + ".wav").duplicate()
	stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
	stream.loop_begin = 0
	stream.loop_end = int(stream.get_length() * stream.mix_rate)
	return stream


func _looping_player(name: String, bus: String, volume_db: float) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.stream = _loop_stream(name)
	p.bus = bus
	p.volume_db = volume_db
	add_child(p)
	return p


func _apply_volumes() -> void:
	_set_bus("Music", Settings.music_volume)
	_set_bus("Sfx", Settings.sfx_volume)


func _set_bus(bus_name: String, linear: float) -> void:
	var i := AudioServer.get_bus_index(bus_name)
	AudioServer.set_bus_mute(i, linear <= 0.01)
	AudioServer.set_bus_volume_db(i, linear_to_db(maxf(linear, 0.01)))


func sfx(name: String) -> void:
	if not _sfx.has(name):
		return
	var p: AudioStreamPlayer = _players[_next]
	_next = (_next + 1) % _players.size()
	p.stream = _sfx[name]
	p.play()


## Background sound of the current place ("" for silence).
func ambience(name: String) -> void:
	if name == _ambience_name:
		return
	_ambience_name = name
	_ambience.stop()
	if name != "":
		_ambience.stream = _loop_stream(name)
		_ambience.play()
